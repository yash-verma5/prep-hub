[
  {"id":"quant-01","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — ratios","section":"quant","subject":"Quantitative Aptitude","topic":"Ratios and percentages","difficulty":"Easy","stem":"Two numbers are in the ratio 3:5 and their sum is 64. What is the smaller number?","options":[{"id":"a","text":"16"},{"id":"b","text":"24"},{"id":"c","text":"32"},{"id":"d","text":"40"}],"correctOptionId":"b","explanation":"The ratio has 8 parts. Each part is 64/8 = 8, so the smaller number is 3 × 8 = 24.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Ratio and proportion"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-02","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — percentages","section":"quant","subject":"Quantitative Aptitude","topic":"Ratios and percentages","difficulty":"Easy","stem":"A price is increased by 20% and then decreased by 20%. The final price is what percentage of the original?","options":[{"id":"a","text":"80%"},{"id":"b","text":"96%"},{"id":"c","text":"100%"},{"id":"d","text":"104%"}],"correctOptionId":"b","explanation":"Using 100 as the original price gives 100 × 1.20 × 0.80 = 96. Equal percentage changes act on different bases.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Percentages"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-03","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — elementary statistics","section":"quant","subject":"Quantitative Aptitude","topic":"Statistics","difficulty":"Easy","stem":"What is the arithmetic mean of 12, 18 and 24?","options":[{"id":"a","text":"16"},{"id":"b","text":"18"},{"id":"c","text":"20"},{"id":"d","text":"22"}],"correctOptionId":"b","explanation":"The mean is (12 + 18 + 24)/3 = 54/3 = 18.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Statistics — arithmetic mean"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-04","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — probability","section":"quant","subject":"Quantitative Aptitude","topic":"Probability","difficulty":"Easy","stem":"A fair six-sided die is rolled once. What is the probability of obtaining a number greater than 4?","options":[{"id":"a","text":"1/6"},{"id":"b","text":"1/3"},{"id":"c","text":"1/2"},{"id":"d","text":"2/3"}],"correctOptionId":"b","explanation":"The favourable outcomes are 5 and 6, so the probability is 2/6 = 1/3.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Probability — equally likely outcomes"}],"reviewNote":"Second-pass checked by enumeration."},
  {"id":"quant-05","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — permutations","section":"quant","subject":"Quantitative Aptitude","topic":"Permutations and combinations","difficulty":"Easy","stem":"In how many ways can four distinct books be arranged in a row?","options":[{"id":"a","text":"4"},{"id":"b","text":"12"},{"id":"c","text":"16"},{"id":"d","text":"24"}],"correctOptionId":"d","explanation":"Four distinct objects can be ordered in 4! = 4 × 3 × 2 × 1 = 24 ways.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Permutations"}],"reviewNote":"Second-pass checked by factorial rule."},
  {"id":"quant-06","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — combinations","section":"quant","subject":"Quantitative Aptitude","topic":"Permutations and combinations","difficulty":"Easy","stem":"How many unordered pairs can be selected from five people?","options":[{"id":"a","text":"5"},{"id":"b","text":"8"},{"id":"c","text":"10"},{"id":"d","text":"20"}],"correctOptionId":"c","explanation":"The number of pairs is C(5,2) = 5 × 4 / 2 = 10.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Combinations"}],"reviewNote":"Second-pass checked by combination formula."},
  {"id":"quant-07","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — series","section":"quant","subject":"Quantitative Aptitude","topic":"Series","difficulty":"Medium","stem":"What is the next term in the series 2, 6, 12, 20, ?","options":[{"id":"a","text":"26"},{"id":"b","text":"28"},{"id":"c","text":"30"},{"id":"d","text":"32"}],"correctOptionId":"c","explanation":"The terms follow n(n+1): 1×2, 2×3, 3×4, 4×5. The next is 5×6 = 30.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Sequences and series"}],"reviewNote":"Second-pass checked from the stated pattern."},
  {"id":"quant-08","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — logarithms","section":"quant","subject":"Quantitative Aptitude","topic":"Powers and logarithms","difficulty":"Easy","stem":"What is log base 2 of 32?","options":[{"id":"a","text":"4"},{"id":"b","text":"5"},{"id":"c","text":"8"},{"id":"d","text":"16"}],"correctOptionId":"b","explanation":"Because 2⁵ = 32, log₂32 = 5.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Exponents and logarithms"}],"reviewNote":"Second-pass checked by exponentiation."},
  {"id":"quant-09","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — mensuration","section":"quant","subject":"Quantitative Aptitude","topic":"Mensuration and geometry","difficulty":"Easy","stem":"Using π = 22/7, what is the area of a circle of radius 7 units?","options":[{"id":"a","text":"44 square units"},{"id":"b","text":"77 square units"},{"id":"c","text":"154 square units"},{"id":"d","text":"308 square units"}],"correctOptionId":"c","explanation":"Area = πr² = (22/7) × 7² = 154 square units.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Areas related to circles"}],"reviewNote":"Second-pass checked by area formula."},
  {"id":"quant-10","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — mensuration","section":"quant","subject":"Quantitative Aptitude","topic":"Mensuration and geometry","difficulty":"Easy","stem":"What is the volume of a cube with side length 3 units?","options":[{"id":"a","text":"9 cubic units"},{"id":"b","text":"18 cubic units"},{"id":"c","text":"27 cubic units"},{"id":"d","text":"36 cubic units"}],"correctOptionId":"c","explanation":"A cube's volume is side³, so 3³ = 27 cubic units.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Surface areas and volumes"}],"reviewNote":"Second-pass checked by volume formula."},
  {"id":"quant-11","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — median","section":"quant","subject":"Quantitative Aptitude","topic":"Statistics","difficulty":"Easy","stem":"What is the median of 1, 3, 5, 7 and 9?","options":[{"id":"a","text":"3"},{"id":"b","text":"4"},{"id":"c","text":"5"},{"id":"d","text":"7"}],"correctOptionId":"c","explanation":"The values are ordered and there are five of them, so the middle (third) value is 5.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Statistics — median"}],"reviewNote":"Second-pass checked by ordered-position rule."},
  {"id":"quant-12","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — mean","section":"quant","subject":"Quantitative Aptitude","topic":"Statistics","difficulty":"Medium","stem":"Five numbers have mean 10. If a sixth number, 16, is added, what is the new mean?","options":[{"id":"a","text":"10"},{"id":"b","text":"11"},{"id":"c","text":"12"},{"id":"d","text":"13"}],"correctOptionId":"b","explanation":"The first five total 5 × 10 = 50. Adding 16 gives 66, and 66/6 = 11.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Statistics — arithmetic mean"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-13","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — data interpretation","section":"quant","subject":"Quantitative Aptitude","topic":"Data interpretation","difficulty":"Medium","stem":"A table shows 12 units sold on Monday and 18 on Tuesday. Tuesday's sales were what percent greater than Monday's?","options":[{"id":"a","text":"25%"},{"id":"b","text":"33⅓%"},{"id":"c","text":"50%"},{"id":"d","text":"66⅔%"}],"correctOptionId":"c","explanation":"The increase is 6 on a Monday base of 12, so the percentage increase is 6/12 × 100 = 50%.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Percentages and data interpretation"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-14","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — ratios","section":"quant","subject":"Quantitative Aptitude","topic":"Ratios and percentages","difficulty":"Medium","stem":"Four workers complete a task in 6 days at a constant rate. How many days would 8 workers take?","options":[{"id":"a","text":"2"},{"id":"b","text":"3"},{"id":"c","text":"6"},{"id":"d","text":"12"}],"correctOptionId":"b","explanation":"The task requires 4 × 6 = 24 worker-days. At the same rate, 24/8 = 3 days.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Inverse proportion"}],"reviewNote":"Second-pass checked by worker-day calculation."},
  {"id":"quant-15","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — percentages","section":"quant","subject":"Quantitative Aptitude","topic":"Ratios and percentages","difficulty":"Easy","stem":"An amount of ₹1,000 grows by 10% in one year. What is the resulting amount?","options":[{"id":"a","text":"₹1,010"},{"id":"b","text":"₹1,050"},{"id":"c","text":"₹1,100"},{"id":"d","text":"₹1,200"}],"correctOptionId":"c","explanation":"Ten percent of ₹1,000 is ₹100, giving ₹1,000 + ₹100 = ₹1,100.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Percentages"}],"reviewNote":"Second-pass checked by direct calculation."},
  {"id":"quant-16","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — geometry","section":"quant","subject":"Quantitative Aptitude","topic":"Mensuration and geometry","difficulty":"Easy","stem":"What is the distance between (0,0) and (3,4) in the Cartesian plane?","options":[{"id":"a","text":"4"},{"id":"b","text":"5"},{"id":"c","text":"6"},{"id":"d","text":"7"}],"correctOptionId":"b","explanation":"Distance = √(3² + 4²) = √25 = 5.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Coordinate geometry — distance formula"}],"reviewNote":"Second-pass checked by distance formula."},
  {"id":"quant-17","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — powers","section":"quant","subject":"Quantitative Aptitude","topic":"Powers and logarithms","difficulty":"Easy","stem":"What is 2³ × 2⁴?","options":[{"id":"a","text":"32"},{"id":"b","text":"64"},{"id":"c","text":"128"},{"id":"d","text":"256"}],"correctOptionId":"c","explanation":"For the same base, add exponents: 2³ × 2⁴ = 2⁷ = 128.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Laws of exponents"}],"reviewNote":"Second-pass checked by exponent rule."},
  {"id":"quant-18","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — estimation","section":"quant","subject":"Quantitative Aptitude","topic":"Numerical estimation","difficulty":"Easy","stem":"Using 200 for 198 and 50 for 51, what is the estimate of 198 × 51?","options":[{"id":"a","text":"1,000"},{"id":"b","text":"5,000"},{"id":"c","text":"10,000"},{"id":"d","text":"20,000"}],"correctOptionId":"c","explanation":"The requested estimate is 200 × 50 = 10,000.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Estimation"}],"reviewNote":"Second-pass checked by stated rounding."},
  {"id":"quant-19","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — probability","section":"quant","subject":"Quantitative Aptitude","topic":"Probability","difficulty":"Medium","stem":"Two fair coins are tossed. What is the probability of getting exactly one head?","options":[{"id":"a","text":"1/4"},{"id":"b","text":"1/3"},{"id":"c","text":"1/2"},{"id":"d","text":"3/4"}],"correctOptionId":"c","explanation":"The equally likely outcomes are HH, HT, TH and TT. Exactly one head occurs in HT and TH, so the probability is 2/4 = 1/2.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Probability — sample spaces"}],"reviewNote":"Second-pass checked by enumeration."},
  {"id":"quant-20","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.2 — series","section":"quant","subject":"Quantitative Aptitude","topic":"Series","difficulty":"Medium","stem":"What is the 10th term of the arithmetic sequence 5, 8, 11, ...?","options":[{"id":"a","text":"29"},{"id":"b","text":"30"},{"id":"c","text":"32"},{"id":"d","text":"35"}],"correctOptionId":"c","explanation":"With first term 5 and common difference 3, a₁₀ = 5 + 9×3 = 32.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Arithmetic progressions"}],"reviewNote":"Second-pass checked by nth-term formula."},
  {"id":"reason-01","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — deduction","section":"reasoning","subject":"Logical Reasoning","topic":"Deduction and induction","difficulty":"Medium","stem":"All routers are devices. Some devices are portable. Which conclusion must follow?","options":[{"id":"a","text":"All routers are portable"},{"id":"b","text":"Some routers are portable"},{"id":"c","text":"No router is portable"},{"id":"d","text":"None of the other conclusions must follow"}],"correctOptionId":"d","explanation":"The portable devices need not be routers, so no statement relating routers to portability is forced by the premises.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Propositional and predicate logic"}],"reviewNote":"Second-pass checked with a counterexample model."},
  {"id":"reason-02","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — analogy","section":"reasoning","subject":"Logical Reasoning","topic":"Analogy","difficulty":"Easy","stem":"CPU is to computer as engine is to which object?","options":[{"id":"a","text":"Road"},{"id":"b","text":"Car"},{"id":"c","text":"Fuel"},{"id":"d","text":"Wheel"}],"correctOptionId":"b","explanation":"A CPU is a central working component of a computer; similarly, an engine is a central working component of a car.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — analogy"}],"reviewNote":"Second-pass checked for a single consistent part-to-whole relation."},
  {"id":"reason-03","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — numerical reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Numerical reasoning","difficulty":"Medium","stem":"What is the next number in 2, 5, 11, 23, ?","options":[{"id":"a","text":"35"},{"id":"b","text":"46"},{"id":"c","text":"47"},{"id":"d","text":"48"}],"correctOptionId":"c","explanation":"Each term is twice the previous term plus 1: 23×2 + 1 = 47.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Sequences and recurrence relations"}],"reviewNote":"Second-pass checked from the stated recurrence."},
  {"id":"reason-04","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Series","difficulty":"Medium","stem":"What is the next letter in A, C, F, J, ?","options":[{"id":"a","text":"M"},{"id":"b","text":"N"},{"id":"c","text":"O"},{"id":"d","text":"P"}],"correctOptionId":"c","explanation":"Alphabet positions increase by 2, 3, 4 and then 5: J is position 10, and 10 + 5 = 15, which is O.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — numerical relations and reasoning"}],"reviewNote":"Second-pass checked by alphabet positions."},
  {"id":"reason-05","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — numerical reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Classification","difficulty":"Easy","stem":"Which number does not belong with the others?","options":[{"id":"a","text":"16"},{"id":"b","text":"25"},{"id":"c","text":"36"},{"id":"d","text":"45"}],"correctOptionId":"d","explanation":"16, 25 and 36 are consecutive perfect squares (4², 5², 6²); 45 is not a perfect square.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Squares and square roots"}],"reviewNote":"Second-pass checked by factorization."},
  {"id":"reason-06","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — spatial reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Direction reasoning","difficulty":"Easy","stem":"A person walks north and then turns right. In which direction are they now walking?","options":[{"id":"a","text":"East"},{"id":"b","text":"West"},{"id":"c","text":"North"},{"id":"d","text":"South"}],"correctOptionId":"a","explanation":"When facing north, a right turn points east.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — transformations and spatial reasoning"}],"reviewNote":"Second-pass checked on a compass orientation."},
  {"id":"reason-07","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — deduction","section":"reasoning","subject":"Logical Reasoning","topic":"Deduction and induction","difficulty":"Medium","stem":"All A are B. No B is C. Which conclusion must be true?","options":[{"id":"a","text":"Some A are C"},{"id":"b","text":"No A is C"},{"id":"c","text":"All C are A"},{"id":"d","text":"Some B are C"}],"correctOptionId":"b","explanation":"Because A is a subset of B and B has no overlap with C, A cannot overlap with C.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Sets and predicate logic"}],"reviewNote":"Second-pass checked by set inclusion."},
  {"id":"reason-08","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Coding patterns","difficulty":"Easy","stem":"If each letter is replaced by the next letter of the alphabet, how is CAT coded?","options":[{"id":"a","text":"DBU"},{"id":"b","text":"DBT"},{"id":"c","text":"CBU"},{"id":"d","text":"EBU"}],"correctOptionId":"a","explanation":"C→D, A→B and T→U, giving DBU.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — reasoning"}],"reviewNote":"Second-pass checked letter by letter."},
  {"id":"reason-09","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — numerical relations","section":"reasoning","subject":"Logical Reasoning","topic":"Ranking","difficulty":"Medium","stem":"A candidate is third from the top and sixth from the bottom. How many candidates are there?","options":[{"id":"a","text":"7"},{"id":"b","text":"8"},{"id":"c","text":"9"},{"id":"d","text":"10"}],"correctOptionId":"b","explanation":"Total = rank from top + rank from bottom − 1 = 3 + 6 − 1 = 8.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — numerical relations"}],"reviewNote":"Second-pass checked by counting the shared person once."},
  {"id":"reason-10","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — mirroring","section":"reasoning","subject":"Logical Reasoning","topic":"Mirroring","difficulty":"Medium","stem":"What is the mirror time of 3:20 on a standard 12-hour analogue clock?","options":[{"id":"a","text":"8:20"},{"id":"b","text":"8:40"},{"id":"c","text":"9:20"},{"id":"d","text":"9:40"}],"correctOptionId":"b","explanation":"For a vertical clock mirror, subtract the time from 11:60: 11:60 − 3:20 = 8:40.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — mirroring"}],"reviewNote":"Second-pass checked geometrically on a clock face."},
  {"id":"reason-11","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — rotation","section":"reasoning","subject":"Logical Reasoning","topic":"Shape transformations","difficulty":"Easy","stem":"A shape is rotated through 360°. How does its final orientation compare with its initial orientation?","options":[{"id":"a","text":"It is mirrored"},{"id":"b","text":"It is upside down"},{"id":"c","text":"It is unchanged"},{"id":"d","text":"It is scaled"}],"correctOptionId":"c","explanation":"A complete 360° rotation returns every point and direction to its starting orientation.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Geometry — rotations"}],"reviewNote":"Second-pass checked from the definition of full rotation."},
  {"id":"reason-12","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — translation","section":"reasoning","subject":"Logical Reasoning","topic":"Shape transformations","difficulty":"Easy","stem":"Which property is preserved when a plane figure is translated?","options":[{"id":"a","text":"Only area"},{"id":"b","text":"Lengths and angles"},{"id":"c","text":"Neither lengths nor angles"},{"id":"d","text":"Orientation is reversed"}],"correctOptionId":"b","explanation":"A translation moves every point by the same vector, preserving distances, angles and orientation.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Geometry — transformations"}],"reviewNote":"Second-pass checked from translation properties."},
  {"id":"reason-13","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — induction","section":"reasoning","subject":"Logical Reasoning","topic":"Deduction and induction","difficulty":"Easy","stem":"Reasoning from several observed cases to a general rule is primarily called what?","options":[{"id":"a","text":"Deduction"},{"id":"b","text":"Induction"},{"id":"c","text":"Contradiction"},{"id":"d","text":"Equivalence"}],"correctOptionId":"b","explanation":"Inductive reasoning generalizes from observed instances; deduction derives necessary consequences from premises.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Rules of inference and proof methods"}],"reviewNote":"Second-pass checked against the standard distinction."},
  {"id":"reason-14","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — reasoning","section":"reasoning","subject":"Logical Reasoning","topic":"Relations","difficulty":"Easy","stem":"Your mother's brother is your what?","options":[{"id":"a","text":"Paternal uncle"},{"id":"b","text":"Maternal uncle"},{"id":"c","text":"Cousin"},{"id":"d","text":"Nephew"}],"correctOptionId":"b","explanation":"A brother on the mother's side is a maternal uncle.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — logical reasoning"}],"reviewNote":"Second-pass checked from the stated relationship."},
  {"id":"reason-15","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.3 — numerical relations","section":"reasoning","subject":"Logical Reasoning","topic":"Analogy","difficulty":"Medium","stem":"Complete the numerical analogy: 4 : 20 :: 6 : ?","options":[{"id":"a","text":"30"},{"id":"b","text":"36"},{"id":"c","text":"42"},{"id":"d","text":"48"}],"correctOptionId":"c","explanation":"The relation is n → n(n+1): 4×5 = 20, so 6×7 = 42.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.3 — analogy and numerical relations"}],"reviewNote":"Second-pass checked from one consistent relation."},
  {"id":"english-01","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — articles","section":"english","subject":"English","topic":"Articles","difficulty":"Easy","stem":"Choose the correct phrase: Rina studies at ___ university.","options":[{"id":"a","text":"a"},{"id":"b","text":"an"},{"id":"c","text":"the only"},{"id":"d","text":"no article is possible"}],"correctOptionId":"a","explanation":"“University” begins with the consonant sound /y/, so the indefinite article is “a”.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Using articles"}],"reviewNote":"Second-pass checked by initial sound."},
  {"id":"english-02","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — verb-noun agreement","section":"english","subject":"English","topic":"Subject-verb agreement","difficulty":"Easy","stem":"Choose the correct verb: Each of the players ___ ready.","options":[{"id":"a","text":"are"},{"id":"b","text":"were"},{"id":"c","text":"is"},{"id":"d","text":"have"}],"correctOptionId":"c","explanation":"The subject “Each” is singular, so it takes the singular verb “is”.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Subject-verb agreement"}],"reviewNote":"Second-pass checked against agreement rule."},
  {"id":"english-03","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — prepositions","section":"english","subject":"English","topic":"Prepositions","difficulty":"Easy","stem":"Choose the correct preposition: She is interested ___ algorithms.","options":[{"id":"a","text":"at"},{"id":"b","text":"in"},{"id":"c","text":"on"},{"id":"d","text":"for"}],"correctOptionId":"b","explanation":"The standard adjective–preposition combination is “interested in”.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Prepositions and idiomatic usage"}],"reviewNote":"Second-pass checked against standard usage."},
  {"id":"english-04","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — tenses","section":"english","subject":"English","topic":"Tenses","difficulty":"Medium","stem":"Choose the correct completion: By next September, she ___ the course.","options":[{"id":"a","text":"completes"},{"id":"b","text":"completed"},{"id":"c","text":"will complete"},{"id":"d","text":"will have completed"}],"correctOptionId":"d","explanation":"The future perfect describes an action completed before a specified future time: “will have completed”.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Verb tenses"}],"reviewNote":"Second-pass checked against future-perfect usage."},
  {"id":"english-05","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — parts of speech","section":"english","subject":"English","topic":"Parts of speech","difficulty":"Easy","stem":"Choose the correct word: The program ran ___.","options":[{"id":"a","text":"quick"},{"id":"b","text":"quickly"},{"id":"c","text":"quicker noun"},{"id":"d","text":"quickness"}],"correctOptionId":"b","explanation":"“Ran” is a verb, and the adverb “quickly” modifies how it ran.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Adjective or adverb"}],"reviewNote":"Second-pass checked by grammatical function."},
  {"id":"english-06","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — conjunctions","section":"english","subject":"English","topic":"Conjunctions","difficulty":"Easy","stem":"Choose the best conjunction: ___ it was raining, the match continued.","options":[{"id":"a","text":"Although"},{"id":"b","text":"Because"},{"id":"c","text":"Unless"},{"id":"d","text":"Therefore"}],"correctOptionId":"a","explanation":"“Although” introduces the contrast between the rain and the match continuing.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Conjunctions"}],"reviewNote":"Second-pass checked for the required contrast."},
  {"id":"english-07","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — vocabulary in context","section":"english","subject":"English","topic":"Vocabulary in context","difficulty":"Medium","stem":"In the sentence “Mobile phones are ubiquitous in cities,” what does “ubiquitous” most nearly mean?","options":[{"id":"a","text":"Rare"},{"id":"b","text":"Expensive"},{"id":"c","text":"Present everywhere"},{"id":"d","text":"Illegal"}],"correctOptionId":"c","explanation":"“Ubiquitous” means present, appearing or found everywhere.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Vocabulary in context"}],"reviewNote":"Second-pass checked against standard dictionary meaning."},
  {"id":"english-08","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — idioms","section":"english","subject":"English","topic":"Idioms and phrases","difficulty":"Easy","stem":"What does the idiom “break the ice” usually mean?","options":[{"id":"a","text":"Damage something"},{"id":"b","text":"Begin a friendly interaction"},{"id":"c","text":"End a meeting"},{"id":"d","text":"Reveal a secret"}],"correctOptionId":"b","explanation":"To “break the ice” is to ease initial social tension and begin conversation.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Idiomatic expressions"}],"reviewNote":"Second-pass checked against standard idiomatic meaning."},
  {"id":"english-09","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — reading comprehension","section":"english","subject":"English","topic":"Reading comprehension","difficulty":"Easy","stem":"Passage: “The server was restarted after the update. Service returned within two minutes.” What happened first?","options":[{"id":"a","text":"Service returned"},{"id":"b","text":"Two minutes ended"},{"id":"c","text":"The server was restarted"},{"id":"d","text":"The update was removed"}],"correctOptionId":"c","explanation":"The first sentence states the restart; the second states that service returned afterward.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Reading for sequence and relationships"}],"reviewNote":"Second-pass checked directly against the passage."},
  {"id":"english-10","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — narrative sequencing","section":"english","subject":"English","topic":"Narrative sequencing","difficulty":"Medium","stem":"Arrange the events logically: P—Submit the form; Q—Review the entries; R—Fill in the details.","options":[{"id":"a","text":"P, Q, R"},{"id":"b","text":"Q, R, P"},{"id":"c","text":"R, Q, P"},{"id":"d","text":"R, P, Q"}],"correctOptionId":"c","explanation":"Details must be filled first, then reviewed, and only then submitted: R, Q, P.","verificationSources":[{"sourceId":"IOCL-GA-SYL-2026","locator":"p.1 — narrative sequencing"}],"reviewNote":"Second-pass checked for prerequisite order."},
  {"id":"english-11","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — grammar","section":"english","subject":"English","topic":"Parallel structure","difficulty":"Medium","stem":"Choose the sentence with correct parallel structure.","options":[{"id":"a","text":"She likes coding, to read, and cycling."},{"id":"b","text":"She likes coding, reading, and cycling."},{"id":"c","text":"She likes to code, reading, and to cycle."},{"id":"d","text":"She likes code, to read, and cycling."}],"correctOptionId":"b","explanation":"“Coding, reading, and cycling” uses the same gerund form for every item in the series.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Parallel structure"}],"reviewNote":"Second-pass checked for matching grammatical forms."},
  {"id":"english-12","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — articles","section":"english","subject":"English","topic":"Articles","difficulty":"Easy","stem":"Choose the correct phrase: He is ___ honest person.","options":[{"id":"a","text":"a"},{"id":"b","text":"an"},{"id":"c","text":"the every"},{"id":"d","text":"no article"}],"correctOptionId":"b","explanation":"“Honest” begins with a vowel sound because the h is silent, so “an” is correct.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Using articles"}],"reviewNote":"Second-pass checked by initial sound."},
  {"id":"english-13","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — grammar","section":"english","subject":"English","topic":"Sentence clarity","difficulty":"Medium","stem":"Choose the clearest sentence.","options":[{"id":"a","text":"After reviewing the code, the bug was fixed by Maya."},{"id":"b","text":"After Maya reviewed the code, she fixed the bug."},{"id":"c","text":"The code after reviewing fixed Maya's bug."},{"id":"d","text":"Reviewing, the bug fixed the code by Maya."}],"correctOptionId":"b","explanation":"Option B names Maya as the actor for both actions and avoids a dangling modifier.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Dangling modifiers and sentence clarity"}],"reviewNote":"Second-pass checked for an explicit modifier target."},
  {"id":"english-14","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — adjectives","section":"english","subject":"English","topic":"Parts of speech","difficulty":"Easy","stem":"In “The reliable network recovered quickly,” which word is an adjective?","options":[{"id":"a","text":"reliable"},{"id":"b","text":"network"},{"id":"c","text":"recovered"},{"id":"d","text":"quickly"}],"correctOptionId":"a","explanation":"“Reliable” describes the noun “network”, so it is an adjective.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Adjectives and adverbs"}],"reviewNote":"Second-pass checked by grammatical function."},
  {"id":"english-15","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"IOCL-GA-SYL-2026","sourceLocator":"p.1 — vocabulary in context","section":"english","subject":"English","topic":"Vocabulary in context","difficulty":"Medium","stem":"In “The patch mitigated the risk,” what does “mitigated” most nearly mean?","options":[{"id":"a","text":"Increased"},{"id":"b","text":"Ignored"},{"id":"c","text":"Reduced the severity of"},{"id":"d","text":"Measured exactly"}],"correctOptionId":"c","explanation":"To mitigate something is to make it less severe, harmful or painful.","verificationSources":[{"sourceId":"PURDUE-OWL","locator":"Vocabulary in context"}],"reviewNote":"Second-pass checked against standard dictionary meaning."}
]
