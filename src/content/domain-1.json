  {"id":"math-01","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — propositional logic","section":"domain","subject":"Engineering Mathematics","topic":"Logic","difficulty":"Medium","stem":"Which proposition is logically equivalent to P → Q?","options":[{"id":"a","text":"Q → P"},{"id":"b","text":"¬P → ¬Q"},{"id":"c","text":"¬Q → ¬P"},{"id":"d","text":"P ∧ ¬Q"}],"correctOptionId":"c","explanation":"An implication is equivalent to its contrapositive, ¬Q → ¬P.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Propositional equivalences"}],"reviewNote":"Second-pass checked by truth table."},
  {"id":"math-02","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — sets","section":"domain","subject":"Engineering Mathematics","topic":"Sets","difficulty":"Easy","stem":"If A = {1,2,3} and B = {2,3,4}, what is A ∩ B?","options":[{"id":"a","text":"{1,4}"},{"id":"b","text":"{2,3}"},{"id":"c","text":"{1,2,3,4}"},{"id":"d","text":"∅"}],"correctOptionId":"b","explanation":"An intersection contains elements common to both sets; those are 2 and 3.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Sets and set operations"}],"reviewNote":"Second-pass checked by membership."},
  {"id":"math-03","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — eigenvalues","section":"domain","subject":"Engineering Mathematics","topic":"Linear algebra","difficulty":"Medium","stem":"What are the eigenvalues of the diagonal matrix diag(2,5)?","options":[{"id":"a","text":"2 and 5"},{"id":"b","text":"0 and 7"},{"id":"c","text":"1 and 10"},{"id":"d","text":"−2 and −5"}],"correctOptionId":"a","explanation":"The eigenvalues of a diagonal matrix are its diagonal entries, here 2 and 5.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Matrices and eigenvalues"}],"reviewNote":"Second-pass checked from (2−λ)(5−λ)."},
  {"id":"math-04","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — conditional probability","section":"domain","subject":"Engineering Mathematics","topic":"Probability","difficulty":"Medium","stem":"If P(A∩B)=0.2 and P(B)=0.5, what is P(A|B)?","options":[{"id":"a","text":"0.1"},{"id":"b","text":"0.2"},{"id":"c","text":"0.4"},{"id":"d","text":"0.7"}],"correctOptionId":"c","explanation":"P(A|B) = P(A∩B)/P(B) = 0.2/0.5 = 0.4.","verificationSources":[{"sourceId":"NCERT-MATH","locator":"Conditional probability"}],"reviewNote":"Second-pass checked by definition."},
  {"id":"math-05","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — graph connectivity","section":"domain","subject":"Engineering Mathematics","topic":"Graph theory","difficulty":"Easy","stem":"How many edges does a tree with 8 vertices have?","options":[{"id":"a","text":"6"},{"id":"b","text":"7"},{"id":"c","text":"8"},{"id":"d","text":"9"}],"correctOptionId":"b","explanation":"Every finite tree with n vertices has n−1 edges, so 8−1 = 7.","verificationSources":[{"sourceId":"ROSEN-DM","locator":"Trees"}],"reviewNote":"Second-pass checked by the tree edge theorem."},
  {"id":"logic-01","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — Boolean algebra","section":"domain","subject":"Digital Logic","topic":"Boolean algebra","difficulty":"Easy","stem":"For a two-input XOR gate, when is the output 1?","options":[{"id":"a","text":"Only when both inputs are 0"},{"id":"b","text":"Only when both inputs are 1"},{"id":"c","text":"When the inputs differ"},{"id":"d","text":"Whenever either input is 0"}],"correctOptionId":"c","explanation":"XOR is 1 exactly when its two binary inputs differ.","verificationSources":[{"sourceId":"MANO-DIGITAL","locator":"Boolean functions and logic gates"}],"reviewNote":"Second-pass checked by truth table."},
  {"id":"logic-02","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — combinational circuits","section":"domain","subject":"Digital Logic","topic":"Combinational circuits","difficulty":"Easy","stem":"Which gates produce the sum and carry outputs of a half adder?","options":[{"id":"a","text":"OR and NOT"},{"id":"b","text":"XOR and AND"},{"id":"c","text":"AND and XOR"},{"id":"d","text":"NOR and NAND"}],"correctOptionId":"b","explanation":"Half-adder sum is A XOR B and carry is A AND B.","verificationSources":[{"sourceId":"MANO-DIGITAL","locator":"Combinational logic — adders"}],"reviewNote":"Second-pass checked by half-adder equations."},
  {"id":"logic-03","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — sequential circuits","section":"domain","subject":"Digital Logic","topic":"Sequential circuits","difficulty":"Medium","stem":"What does a JK flip-flop do on the active clock edge when J=1 and K=1?","options":[{"id":"a","text":"Resets"},{"id":"b","text":"Sets"},{"id":"c","text":"Holds"},{"id":"d","text":"Toggles"}],"correctOptionId":"d","explanation":"The J=K=1 condition complements the current output, so it toggles.","verificationSources":[{"sourceId":"MANO-DIGITAL","locator":"Flip-flops"}],"reviewNote":"Second-pass checked by characteristic table."},
  {"id":"logic-04","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — number representations","section":"domain","subject":"Digital Logic","topic":"Number representation","difficulty":"Easy","stem":"What is the range of an 8-bit two's-complement integer?","options":[{"id":"a","text":"−127 to 127"},{"id":"b","text":"−128 to 127"},{"id":"c","text":"−128 to 128"},{"id":"d","text":"0 to 255"}],"correctOptionId":"b","explanation":"An n-bit two's-complement value ranges from −2^(n−1) to 2^(n−1)−1; here, −128 to 127.","verificationSources":[{"sourceId":"MANO-DIGITAL","locator":"Signed binary numbers"}],"reviewNote":"Second-pass checked by range formula."},
  {"id":"logic-05","status":"approved","provenance":"original","attribution":"Original for IOCL Prep Hub","sourceId":"GATE-CS-SYL-2026","sourceLocator":"p.1 — Boolean algebra","section":"domain","subject":"Digital Logic","topic":"Boolean algebra","difficulty":"Medium","stem":"By De Morgan's law, what is ¬(A ∨ B)?","options":[{"id":"a","text":"¬A ∨ ¬B"},{"id":"b","text":"¬A ∧ ¬B"},{"id":"c","text":"A ∧ B"},{"id":"d","text":"A ∨ ¬B"}],"correctOptionId":"b","explanation":"De Morgan's law complements each operand and changes OR to AND.","verificationSources":[{"sourceId":"MANO-DIGITAL","locator":"De Morgan's theorems"}],"reviewNote":"Second-pass checked by truth table."}
